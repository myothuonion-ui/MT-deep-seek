# MT Pentester non-secret runtime configuration.
API_AUTH_TOKEN=
SCOPE_ALLOWLIST=
ALLOW_UNSCOPED_TARGETS=false
FULL_AUTO_MODE=false

# Read-only Claude-BugHunter methodology routing (never executes bundle scripts).
CLAUDE_SKILL_ROUTING=auto
CLAUDE_SKILL_MAX=3
CLAUDE_SKILL_EXCERPT_CHARS=1800

# Choose: local, deepseek, openrouter, nvidia_nim, gemini, litellm
AI_PROVIDER=local
AI_CONTEXT_WINDOW=131072

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_CONTEXT_WINDOW=8192

# Supply credentials at runtime or via container secrets. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/myothuonion-ui/MT-deep-seek

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

LITELLM_MASTER_KEY=
LITELLM_API_BASE=http://localhost:4000/v1
LITELLM_MODEL=planner-strong

# Backend binding. Keep localhost unless the API is protected at the network layer.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=6000
FRONTEND_PORT=8501
DOCS_PORT=3500

# Operational policy
DEFAULT_RISK_THRESHOLD=medium
AUTO_APPROVE_LOW_RISK=false
MAX_AUTO_DEPTH=5
REQUIRE_APPROVAL_HIGH_RISK=true
INCLUDE_SECRETS_IN_REPORTS=false

# Runtime limits
SCAN_TIMEOUT=300
MAX_CONCURRENT_SCANS=3
COMMAND_TIMEOUT=600

# Optional CVE/CVSS enrichment
VULNERS_API_KEY=

# Storage and logs
DB_PATH=mt_pentester.db
EVIDENCE_GRAPH_PATH=mt_evidence_graph.db
# Optional operator-managed directory for scope-checked browser screenshots.
# BROWSER_ARTIFACT_DIR=/app/data/browser-evidence
# Optional separate HMAC key for signed agent-graph state. If unset, the
# backend API token is used. Use at least 16 random characters.
# AGENT_GRAPH_SIGNING_KEY=

# Task-aware model routing is opt-in. With routing disabled, every role keeps
# using the active AI_PROVIDER and no cross-provider data transfer occurs.
MODEL_ROUTING_ENABLED=false
MODEL_ROUTING_AUTO_SELECT=false
MODEL_ROUTING_ALLOWED_PROVIDERS=
MODEL_ROUTING_SENSITIVITY=standard
# Explicit examples (provider codes only):
# MODEL_ROUTE_STRATEGIST=litellm
# MODEL_ROUTE_VERIFIER=local
LOG_LEVEL=INFO
LOG_FILE=mt_pentester.log

# Development
DEBUG=false
RELOAD=false

# Optional tool overrides
# NMAP_PATH=/usr/bin/nmap
# METASPLOIT_PATH=/usr/bin/msfconsole
